<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Relevamiento — GCBA</title>
<link rel="icon" type="image/png" href="https://lh3.googleusercontent.com/d/1Og4pbNqa53tbZv9YfO90xY3Wo2gVPqBG">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --azul-oscuro:   #1D3343;
    --amarillo:      #FFD200;
    --amarillo-osc:  #E6BD00;
    --gris-texto:    #333333;
    --gris-muted:    #666666;
    --gris-bg:       #F5F5F5;
    --gris-borde:    #DDDDDD;
    --gris-card:     #FAFAFA;
    --blanco:        #FFFFFF;
    --azul:          #0072BC;
    --bien-bg:       #E8F5E9; --bien-txt: #2E7D32; --bien-borde: #66BB6A;
    --reg-bg:        #FFF8E1; --reg-txt:  #E65100; --reg-borde:  #FFA726;
    --mal-bg:        #FFEBEE; --mal-txt:  #C62828; --mal-borde:  #EF5350;
    --radio:         4px;
    --font:          'Nunito Sans', Arial, sans-serif;
    --font-titulos:  'Archivo', 'Nunito Sans', Arial, sans-serif;
  }

  body {
    font-family: var(--font);
    background: var(--gris-bg);
    color: var(--gris-texto);
    font-size: 15px;
    padding-bottom: 2.5rem;
  }

  /* ── HEADER ── */
  .app-header {
    background: var(--azul-oscuro);
    padding: 0 16px;
    position: sticky; top: 0; z-index: 100;
    border-bottom: 3px solid var(--amarillo);
  }
  .app-header-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 0;
  }
  .header-marca { display: flex; align-items: center; gap: 10px; }
  .header-escudo {
    width: 36px; height: 36px;
    background: transparent;
    border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .header-textos { line-height: 1.2; }
  .header-textos .org {
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em;
    color: var(--blanco); opacity: .65;
  }
  .header-textos .titulo {
    font-family: var(--font-titulos);
    font-size: 14px; font-weight: 700; color: var(--blanco);
  }
  .header-acciones { display: flex; align-items: center; gap: 8px; }
  .btn-refrescar {
    width: 30px; height: 30px; flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.3);
    background: rgba(255,255,255,.12);
    color: var(--blanco);
    font-size: 14px; line-height: 1;
    cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .btn-refrescar:active { background: rgba(255,255,255,.28); }
  .btn-refrescar.girando { animation: spin .8s linear infinite; }
  .btn-refrescar:disabled { opacity: .5; cursor: not-allowed; }

  .estado-conexion {
    display: flex; align-items: center; gap: 5px;
    font-size: 10px; font-weight: 700;
    padding: 4px 9px; border-radius: 20px; white-space: nowrap;
    background: rgba(255,255,255,.12); color: var(--blanco);
  }
  .estado-conexion .punto { width: 6px; height: 6px; border-radius: 50%; }
  .estado-conexion.online .punto  { background: #4CAF50; }
  .estado-conexion.offline .punto { background: var(--amarillo); animation: parpadeo 1.4s infinite; }
  @keyframes parpadeo { 0%,100%{opacity:1} 50%{opacity:.2} }

  /* ── BANNER PENDIENTES ── */
  .banner-pendientes {
    display: none;
    background: #FFF8E1;
    border-left: 4px solid #FFA726;
    margin: 14px 12px 0; padding: 11px 14px;
    align-items: center; gap: 10px;
    border-radius: var(--radio);
  }
  .banner-pendientes.visible { display: flex; }
  .banner-pendientes .icono { font-size: 18px; }
  .banner-pendientes .texto { flex: 1; font-size: 12px; color: #E65100; line-height: 1.4; }
  .banner-pendientes .texto strong { display: block; font-size: 13px; font-weight: 700; margin-bottom: 1px; }
  .banner-pendientes .btn-reintentar {
    font-size: 11px; font-weight: 700; color: #E65100;
    background: var(--blanco); border: 1px solid #FFA726;
    border-radius: var(--radio); padding: 6px 10px;
    cursor: pointer; white-space: nowrap;
  }

  /* ── SECCIONES ── */
  .seccion {
    background: var(--blanco);
    border-radius: var(--radio);
    border: 1px solid var(--gris-borde);
    margin: 14px 12px 0;
    overflow: hidden;
  }
  .seccion-titulo {
    font-family: var(--font-titulos);
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .1em;
    color: var(--azul-oscuro);
    padding: 10px 14px 8px;
    border-bottom: 2px solid var(--amarillo);
    background: var(--blanco);
    display: flex; align-items: center; gap: 7px;
  }
  .seccion-titulo .num {
    background: var(--amarillo); color: var(--azul-oscuro);
    font-size: 10px; font-weight: 800;
    width: 18px; height: 18px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .seccion-titulo .opcional {
    margin-left: auto;
    font-family: var(--font);
    font-size: 9px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em;
    color: var(--gris-muted);
    background: var(--gris-bg);
    border: 1px solid var(--gris-borde);
    border-radius: 20px; padding: 2px 8px;
  }
  .seccion-cuerpo { padding: 14px; }

  /* ── CAMPOS ── */
  .campo { margin-bottom: 14px; }
  .campo:last-child { margin-bottom: 0; }
  .campo label {
    display: block; font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    color: var(--gris-muted); margin-bottom: 5px;
  }
  .req {
    color: var(--mal-txt);
    font-weight: 800;
    margin-left: 2px;
  }
  select.falta {
    border-color: var(--mal-borde);
    background: var(--mal-bg);
  }
  select, textarea {
    width: 100%; padding: 12px;
    border: 1.5px solid var(--gris-borde);
    border-radius: var(--radio);
    font-size: 16px;
    font-family: var(--font);
    color: var(--gris-texto); background: var(--blanco);
    appearance: none; -webkit-appearance: none;
  }
  select:focus, textarea:focus {
    outline: none; border-color: var(--amarillo);
    box-shadow: 0 0 0 3px rgba(255,210,0,.2);
  }
  .select-wrap { position: relative; }
  .select-wrap::after {
    content: '▾';
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    color: var(--gris-muted); pointer-events: none; font-size: 13px;
  }

  /* ── CAMPO AUTOMÁTICO ── */
  .campo-auto {
    display: flex; align-items: center; gap: 10px;
    background: var(--gris-bg);
    border: 1.5px solid var(--gris-borde);
    border-radius: var(--radio); padding: 10px 12px;
  }
  .campo-auto .icono { font-size: 17px; }
  .campo-auto .etiqueta { font-size: 11px; color: var(--gris-muted); }
  .campo-auto .valor { font-size: 13px; font-weight: 700; color: var(--gris-texto); margin-top: 1px; }
  .badge-auto {
    margin-left: auto; font-size: 10px; font-weight: 700;
    background: var(--amarillo); color: var(--gris-texto);
    border-radius: 3px; padding: 2px 6px; white-space: nowrap;
  }

  /* ── INFO SITIO / ESPACIO ── */
  .info-sitio {
    background: var(--gris-bg);
    border: 1.5px solid var(--gris-borde);
    border-radius: var(--radio);
    overflow: hidden; margin-top: 6px;
  }
  .info-sitio-fila {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 8px 12px;
    border-bottom: 1px solid var(--gris-borde);
    font-size: 13px; gap: 10px;
  }
  .info-sitio-fila:last-child { border-bottom: none; }
  .info-sitio-fila .clave { color: var(--gris-muted); font-size: 12px; flex-shrink: 0; }
  .info-sitio-fila .valor { font-weight: 700; color: var(--gris-texto); text-align: right; }
  .tel-link {
    color: var(--azul-oscuro);
    text-decoration: none;
    border-bottom: 1.5px solid var(--amarillo);
    padding-bottom: 1px;
    white-space: nowrap;
  }
  .tel-link:active { opacity: .6; }

  /* ── ÁREAS ── */
  .areas-titulo {
    font-family: var(--font-titulos);
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .1em;
    color: var(--azul-oscuro);
    padding: 16px 12px 6px;
  }
  .area-card {
    border: 1.5px solid var(--gris-borde);
    border-radius: var(--radio);
    margin: 8px 12px 0; overflow: hidden;
    background: var(--blanco);
  }
  .area-header {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px; background: var(--blanco);
    cursor: pointer; user-select: none;
    border-left: 4px solid var(--amarillo);
  }
  .area-icono { font-size: 20px; flex-shrink: 0; }
  .area-nombre {
    font-family: var(--font-titulos);
    font-size: 14px; font-weight: 600; flex: 1;
    color: var(--azul-oscuro); line-height: 1.3;
  }
  .area-chevron { font-size: 13px; color: var(--gris-muted); transition: transform .2s; flex-shrink: 0; }
  .area-card.abierta .area-chevron { transform: rotate(180deg); }
  .area-body {
    display: none; padding: 14px;
    border-top: 1.5px solid var(--gris-borde);
    background: var(--gris-card);
  }
  .area-card.abierta .area-body { display: block; }

  /* ── EVALUACIONES ── */
  .eval-fila { margin-bottom: 12px; }
  .eval-fila:last-child { margin-bottom: 0; }
  .eval-label-linea {
    display: flex; align-items: center; gap: 6px; margin-bottom: 6px;
  }
  .eval-label {
    font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
    color: var(--gris-muted);
  }
  .btn-ayuda {
    width: 17px; height: 17px; flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid var(--azul-oscuro);
    background: var(--blanco);
    color: var(--azul-oscuro);
    font-family: var(--font-titulos);
    font-size: 10px; font-weight: 800;
    line-height: 1; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0;
  }
  .btn-ayuda:active { background: var(--amarillo); }
  .pill-grupo { display: flex; gap: 6px; border-radius: var(--radio); }
  .pill-grupo.falta-eval {
    outline: 2px solid var(--mal-borde);
    outline-offset: 3px;
  }
  .pill {
    flex: 1; text-align: center;
    font-size: 14px; font-weight: 700;
    font-family: var(--font);
    padding: 11px 4px;
    border-radius: var(--radio);
    border: 1.5px solid var(--gris-borde);
    color: var(--gris-muted); background: var(--blanco);
    cursor: pointer; transition: all .15s;
  }
  .pill:active { transform: scale(.97); }
  .pill.sel-bien    { background: var(--bien-bg); color: var(--bien-txt); border-color: var(--bien-borde); }
  .pill.sel-regular { background: var(--reg-bg);  color: var(--reg-txt);  border-color: var(--reg-borde); }
  .pill.sel-mal     { background: var(--mal-bg);  color: var(--mal-txt);  border-color: var(--mal-borde); }

  /* ── DETALLE POR EVALUACIÓN (notas + foto) ── */
  .eval-detalle {
    display: none;
    margin-top: 8px;
    padding: 10px;
    background: var(--blanco);
    border: 1px solid var(--gris-borde);
    border-left: 3px solid var(--gris-borde);
    border-radius: var(--radio);
  }
  .eval-detalle.visible { display: block; }
  .eval-detalle.nivel-regular { border-left-color: var(--reg-borde); }
  .eval-detalle.nivel-mal     { border-left-color: var(--mal-borde); }
  .eval-detalle .mini-label {
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em;
    color: var(--gris-muted);
    display: block; margin-bottom: 4px;
  }
  .eval-detalle .mini-label .aclara {
    font-weight: 600; text-transform: none; letter-spacing: 0;
    color: var(--gris-muted); opacity: .75;
  }
  .eval-detalle textarea { font-size: 14px; padding: 8px 10px; }

  /* ── OPCIONES MARCABLES ── */
  .opciones { margin-bottom: 8px; }
  .opcion {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 7px 8px; margin-bottom: 4px;
    border: 1px solid var(--gris-borde);
    border-radius: var(--radio);
    background: var(--blanco);
    cursor: pointer;
    font-size: 13px; line-height: 1.35;
  }
  .opcion:last-child { margin-bottom: 0; }
  .opcion input[type=checkbox] {
    width: 17px; height: 17px; margin: 1px 0 0 0;
    accent-color: var(--azul-oscuro);
    flex-shrink: 0;
  }
  .opcion:has(input:checked) {
    background: #EEF4F8;
    border-color: var(--azul-oscuro);
    font-weight: 600;
  }
  .otro-texto { display: none; margin-top: 6px; }
  .otro-texto.visible { display: block; }

  /* ── ÍTEM INFORMATIVO (luminaria / arbolado) ── */
  .tag-informativo {
    margin-left: auto;
    font-size: 9px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .04em;
    color: var(--gris-muted);
    background: var(--gris-bg);
    border: 1px solid var(--gris-borde);
    border-radius: 20px; padding: 2px 7px;
    white-space: nowrap;
  }
  .btn-reportar-problema {
    width: 100%;
    font-family: var(--font);
    font-size: 13px; font-weight: 700;
    color: var(--gris-muted);
    background: var(--blanco);
    border: 1.5px dashed var(--gris-borde);
    border-radius: var(--radio);
    padding: 10px; cursor: pointer;
  }
  .btn-reportar-problema.activo {
    color: var(--mal-txt);
    border-style: solid;
    border-color: var(--mal-borde);
    background: var(--mal-bg);
  }
  .ayuda-corta {
    font-size: 12px; line-height: 1.45;
    color: var(--gris-muted);
    margin-bottom: 9px;
  }

  /* ── AVISO DE NOTA FALTANTE ── */
  .eval-detalle.falta-nota {
    outline: 2px solid var(--mal-borde);
    outline-offset: 2px;
  }

  /* ── FOTO (opcional, por evaluación) ── */
  .foto-zona { display: none; margin-top: 10px; }
  .foto-zona.visible { display: block; }
  .foto-zona input[type=file] { display: none; }

  /* Dos botones separados: cámara y galería.
     Android no abre la cámara desde el selector de archivos común,
     por eso cada acción tiene su propio input. */
  .foto-botones { display: flex; flex-wrap: wrap; gap: 6px; }
  .foto-btn-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 700; font-family: var(--font);
    color: var(--azul-oscuro); background: var(--blanco);
    border: 1.5px dashed var(--gris-borde);
    border-radius: var(--radio);
    padding: 9px 14px; cursor: pointer;
  }
  .foto-btn-label:active { background: var(--gris-bg); }
  /* El botón de galería solo se muestra a los relevadores habilitados
     (columna B de la hoja RELEVADORES). */
  .btn-galeria { display: none; }
  .fotos-grilla {
    display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px;
  }
  .foto-mini {
    position: relative;
    width: calc(33.333% - 4px);
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--gris-borde);
  }
  .foto-mini img { width: 100%; height: 78px; object-fit: cover; display: block; }
  .foto-quitar {
    position: absolute; top: 3px; right: 3px;
    width: 22px; height: 22px; border-radius: 50%;
    border: none; background: rgba(29,51,67,.8); color: #fff;
    font-size: 11px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    padding: 0;
  }

  textarea { resize: none; line-height: 1.5; }


  /* ── EQUIPAMIENTO ── */
  .equipo-card {
    border: 1px solid var(--gris-borde);
    border-radius: var(--radio);
    margin-bottom: 10px;
    background: var(--blanco);
    overflow: hidden;
  }
  .equipo-card:last-child { margin-bottom: 0; }
  .equipo-card.falta-suma { outline: 2px solid var(--mal-borde); outline-offset: 2px; }
  .equipo-header {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 11px;
    background: var(--gris-bg);
    border-bottom: 1px solid var(--gris-borde);
  }
  .equipo-nombre {
    font-family: var(--font-titulos);
    font-size: 13px; font-weight: 600;
    color: var(--azul-oscuro); flex: 1;
  }
  .equipo-total {
    font-size: 11px; font-weight: 700;
    color: var(--gris-muted);
    background: var(--blanco);
    border: 1px solid var(--gris-borde);
    border-radius: 20px; padding: 2px 9px;
    white-space: nowrap;
  }
  .equipo-cuerpo { padding: 11px; }

  .conteo-fila {
    display: flex; align-items: center; gap: 9px;
    padding: 7px 0;
    border-bottom: 1px solid var(--gris-borde);
  }
  .conteo-fila:last-of-type { border-bottom: none; }
  .conteo-etiqueta {
    flex: 1; font-size: 12.5px; line-height: 1.3;
    color: var(--gris-texto);
  }
  .conteo-etiqueta .punto-estado {
    display: inline-block; width: 8px; height: 8px;
    border-radius: 50%; margin-right: 6px;
    vertical-align: 1px;
  }
  .punto-ok   { background: var(--bien-borde); }
  .punto-dano { background: var(--reg-borde); }
  .punto-no   { background: var(--mal-borde); }

  .contador { display: flex; align-items: center; gap: 0; flex-shrink: 0; }
  .contador button {
    width: 32px; height: 32px;
    border: 1.5px solid var(--gris-borde);
    background: var(--blanco);
    color: var(--azul-oscuro);
    font-size: 17px; font-weight: 700;
    line-height: 1; cursor: pointer; padding: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .contador button:first-child { border-radius: var(--radio) 0 0 var(--radio); }
  .contador button:last-child  { border-radius: 0 var(--radio) var(--radio) 0; }
  .contador button:active { background: var(--gris-bg); }
  .contador button:disabled { opacity: .35; cursor: not-allowed; }
  .contador input {
    width: 44px; height: 32px;
    border: 1.5px solid var(--gris-borde);
    border-left: none; border-right: none;
    text-align: center;
    font-family: var(--font);
    font-size: 15px; font-weight: 700;
    color: var(--gris-texto);
    background: var(--blanco);
    -moz-appearance: textfield;
    padding: 0;
  }
  .contador input::-webkit-outer-spin-button,
  .contador input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .equipo-suma {
    font-size: 11.5px; font-weight: 700;
    text-align: right; padding: 7px 0 0;
    color: var(--bien-txt);
  }
  .equipo-suma.error { color: var(--mal-txt); }

  .equipo-extra {
    display: none;
    margin-top: 9px; padding: 10px;
    border-radius: var(--radio);
    background: var(--gris-card);
    border: 1px solid var(--gris-borde);
  }
  .equipo-extra.visible { display: block; }
  .equipo-extra.falta-nota { outline: 2px solid var(--mal-borde); outline-offset: 2px; }
  .equipo-extra .mini-label {
    font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em;
    color: var(--gris-muted);
    display: block; margin-bottom: 5px;
  }
  .equipo-extra .mini-label .aclara {
    font-weight: 600; text-transform: none; letter-spacing: 0; opacity: .75;
  }

  /* ── MAPA ── */
  .geo-mapa {
    border: 1.5px solid var(--gris-borde);
    border-radius: var(--radio);
    overflow: hidden; height: 180px;
  }
  .geo-mapa iframe { width: 100%; height: 100%; border: 0; display: block; }

  /* ── MODAL DE AYUDA ── */
  .modal-fondo {
    display: none;
    position: fixed; inset: 0;
    background: rgba(29,51,67,.6);
    z-index: 500;
    align-items: center; justify-content: center;
    padding: 20px;
  }
  .modal-fondo.visible { display: flex; }
  .modal-caja {
    background: var(--blanco);
    border-radius: var(--radio);
    width: 100%; max-width: 420px;
    max-height: 82vh; overflow-y: auto;
    border-top: 4px solid var(--amarillo);
  }
  .modal-header {
    display: flex; align-items: center; gap: 10px;
    padding: 14px; border-bottom: 1px solid var(--gris-borde);
    position: sticky; top: 0; background: var(--blanco);
  }
  .modal-header h3 {
    font-family: var(--font-titulos);
    font-size: 14px; font-weight: 700;
